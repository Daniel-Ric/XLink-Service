# === Server Settings ===
PORT=8080                   # API port in production
NODE_ENV=production         # must be production
TRUST_PROXY=loopback        # trust only local reverse proxy hops; use a hop count like 1 for external load balancers

# === Auth & Security ===
CLIENT_ID=0000000048183522        # Microsoft/Xbox OAuth client ID (Minecraft Bedrock Android default; see README for alternatives)
MICROSOFT_AUTH_MODE=auto          # auto, legacy, or modern
JWT_SECRET=replace_with_strong_secret_key_32chars_min # long random secret (>=32 chars)

# === Entra Browser Login (requires CLIENT_ID to be your own Entra application GUID) ===
# MICROSOFT_OAUTH_REDIRECT_URI=https://api.yourdomain.com/auth/browser/callback
# MICROSOFT_OAUTH_FRONTEND_REDIRECT_URI=https://yourdomain.com/auth/callback
# MICROSOFT_OAUTH_CLIENT_SECRET=replace_with_entra_web_app_secret
# MICROSOFT_OAUTH_TTL_MS=300000

# === Logging ===
LOG_LEVEL=warn              # only warnings and errors
LOG_PRETTY=false            # disable pretty logs in production

# === Swagger / API Docs ===
SWAGGER_ENABLED=false       # disable Swagger UI in production
SWAGGER_SERVER_URL=https://your-server-domain.com #Swagger API docs URL

# === Xbox / PlayFab / Minecraft ===
PLAYFAB_TITLE_ID=20ca2 # PlayFab Title ID
MC_GAME_VERSION=1.21.62     # Minecraft game version (keep updated)
MC_PLATFORM=Windows10       # platform (adjust if needed)
REDEEM_CLIENT_TYPE=MinecraftNet
REDEEM_DEVICE_FAMILY=Web

# === XSAPI / XAL ===
XAL_CLIENT_ID=0000000048183522
XAL_TITLE_ID=1739947436
XAL_SANDBOX=RETAIL
XAL_DEVICE_TYPE=Android
XAL_DEVICE_VERSION=13
XAL_USER_AGENT=XAL Android 2025.04.20250326.000
XSAPI_SESSION_TTL_MS=600000

# === CORS ===
CORS_ORIGIN=https://yourdomain.com  # only allow your production frontend
